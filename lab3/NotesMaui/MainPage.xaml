<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NotesMaui.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:PilotNotes.Core;assembly=PilotNotes.Core"
    x:DataType="core:NotesViewModel">

    <Grid Padding="16" RowSpacing="8"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">

        <Entry Grid.Row="0"
               Placeholder="Новая заметка"
               Text="{Binding Draft, Mode=TwoWay}" />

        <Entry Grid.Row="1"
               Placeholder="Поиск"
               Text="{Binding Query, Mode=TwoWay}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Добавить" Command="{Binding AddCommand}" />
            <Button Grid.Column="1" Text="Найти" Command="{Binding SearchCommand}" />
            <Button Grid.Column="2" Text="Сбросить" Command="{Binding ResetSearchCommand}" />
        </Grid>

        <Label Grid.Row="3" Text="{Binding CountText}" />

        <CollectionView Grid.Row="4"
                        ItemsSource="{Binding VisibleNotes}"
                        SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:Note">
                    <Label Padding="8" Text="{Binding Text}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="Удалить" Command="{Binding DeleteCommand}" />
            <Button Grid.Column="1" Text="Сохранить" Command="{Binding SaveCommand}" />
            <Button Grid.Column="2" Text="Загрузить" Command="{Binding LoadCommand}" />
        </Grid>

        <Label Grid.Row="6" Text="{Binding SaveState}" />
        <Label Grid.Row="7" Text="{Binding Status}" />

    </Grid>
</ContentPage>
