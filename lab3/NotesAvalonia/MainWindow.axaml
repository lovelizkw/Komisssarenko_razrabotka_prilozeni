<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PilotNotes.Core;assembly=PilotNotes.Core"
        x:Class="NotesAvalonia.MainWindow"
        x:DataType="core:NotesViewModel"
        Title="Заметки пилота"
        Width="560" Height="480">

    <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnDefinitions="*" ColumnSpacing="8">

        <TextBox Grid.Row="0" Grid.Column="0"
                 Watermark="Новая заметка"
                 Text="{Binding Draft, Mode=TwoWay}" />

        <TextBox Grid.Row="1" Grid.Column="0"
                 Watermark="Поиск"
                 Text="{Binding Query, Mode=TwoWay}" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Добавить" Command="{Binding AddCommand}" />
            <Button Grid.Column="1" Content="Найти" Command="{Binding SearchCommand}" />
            <Button Grid.Column="2" Content="Сбросить" Command="{Binding ResetSearchCommand}" />
        </Grid>

        <TextBlock Grid.Row="3" Margin="0,8,0,0" Text="{Binding CountText}" />

        <ListBox Grid.Row="4" Margin="0,8,0,0"
                 ItemsSource="{Binding VisibleNotes}"
                 SelectedItem="{Binding SelectedNote, Mode=TwoWay}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="core:Note">
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="5" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="Удалить" Command="{Binding DeleteCommand}" />
            <Button Grid.Column="1" Content="Сохранить" Command="{Binding SaveCommand}" />
            <Button Grid.Column="2" Content="Загрузить" Command="{Binding LoadCommand}" />
        </Grid>

        <TextBlock Grid.Row="6" Margin="0,8,0,0" Text="{Binding SaveState}" />
        <TextBlock Grid.Row="7" Margin="0,8,0,0" Text="{Binding Status}" />

    </Grid>
</Window>
